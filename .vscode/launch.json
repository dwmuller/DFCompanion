{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug DFCompanion",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/cargo/debug/dfcompanion.exe",
      "cwd": "${workspaceFolder}",
      "args": [],
      "preLaunchTask": "Build and Install DFCompanion (Debug)",
      "terminal": "integrated",
      "serverReadyAction": {
        "pattern": "DFCompanion web UI listening on (http://\\S+)",
        "uriFormat": "%s/",
        "action": "openExternally"
      }
    }
  ]
}
