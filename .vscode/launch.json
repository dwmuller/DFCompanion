{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug DFCompanion",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/cargo/debug/dfcompanion.exe",
      "cwd": "${workspaceFolder}",
      "args": ["--trace-http", "--trace-file", "trace.log"],
      "preLaunchTask": "Build and Install DFCompanion (Debug)",
      "terminal": "integrated",
      "env": {
        "RUST_LOG": "info,dfcompanion=debug,dfcompanion::game_state=trace",
        "RUST_BACKTRACE": "1"
      }
    }
  ]
}
