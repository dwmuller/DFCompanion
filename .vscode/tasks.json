{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build and Install DFCompanion (Debug)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build",
        "--config",
        "Debug",
        "--target",
        "install-dfhack-script"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run DFCompanion Server",
      "type": "shell",
      "command": "cargo run",
      "isBackground": true,
      "problemMatcher": {
        "owner": "rust",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Compiling|Running",
          "endsPattern": "listening on http://127\\.0\\.0\\.1:3000"
        }
      }
    }
  ]
}
